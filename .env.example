# Discord Bot Token (From https://discord.com/developers/applications)
DISCORD_TOKEN=your_discord_bot_token_here

# The Movie Database (TMDB) API Key (Free from https://www.themoviedb.org/settings/api)
# Used for movie posters, backdrop banners, overview, and ratings.
TMDB_API_KEY=your_tmdb_api_key_here

# Google Gemini API Key (Free from https://aistudio.google.com/)
# Used for AI movie discussion starters, trivia, and thread questions.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom animated GIF URL for the jar drawing animation
JAR_ANIMATION_GIF=https://media.giphy.com/media/26ybvVb95UctxcPBu/giphy.gif
